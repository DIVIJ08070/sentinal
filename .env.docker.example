# Copy to .env and adjust. Used by docker-compose.yml.

# --- PostgreSQL (local container; these are fine for a demo) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- HLS relay URL the dashboard loads camera video from ---
# The browser runs on the host, so localhost:8888 reaches the published relay.
GRID_HLS_TEMPLATE=http://localhost:8888/{id}/index.m3u8

# --- Live analytics only (compose --profile live) ---
# Your government-grid credential as  email:password  (the same value
# live-with-auth.sh builds). Leave blank for the core, no-credential stack.
# Never commit your real value — .env is gitignored.
GRID_RTSP_AUTH=
